# .env.example — copy to .env and fill in values
PORT=5000
NODE_ENV=development

# MongoDB connection string - NO database name in the path
# Correct: mongodb+srv://user:pass@cluster.mongodb.net
# Incorrect: mongodb+srv://user:pass@cluster.mongodb.net/CRM_Prod
MONGODB_URI=

# Database Name - Allowed values: CRM_Prod, CRM_Dev, TESTDATA, travel_crm
DB_NAME=CRM_Dev

JWT_SECRET=
BASE_URL=http://localhost:5000
EXTERNAL_API_KEY=
FRONTEND_URL=http://localhost:3000
