{
  "name": "travel-crm-backend",
  "version": "1.0.0",
  "description": "Travel Booking CRM Backend",
  "main": "src/server.ts",
  "scripts": {
    "dev": "npx ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsup",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "seed": "npx ts-node src/seed.ts",
    "migrate:roles": "ts-node src/scripts/normalizeRoles.ts",
    "migrate": "ts-node src/scripts/migrateData.ts"
  },
  "dependencies": {
    "@travel-crm/shared": "file:../shared",
    "@types/bcrypt": "^6.0.0",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/morgan": "^1.9.9",
    "@types/node": "^22.0.0",
    "@types/node-cache": "^4.1.3",
    "@types/node-fetch": "^2.6.13",
    "bcrypt": "^6.0.0",
    "chrono-node": "^2.9.0",
    "compression": "^1.8.1",
    "compromise": "^14.15.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.18.2",
    "express-async-handler": "^1.2.0",
    "express-rate-limit": "^8.5.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^9.6.2",
    "morgan": "^1.10.0",
    "node-cache": "^5.1.2",
    "node-fetch": "^2.7.0",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^6.0.2",
    "winston": "^3.19.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "tsup": "^8.5.1"
  }
}
